# ============================================================================
# SECTION B - ALL M1a OVERALL SEED SCORES (scripts/explore/syn/finalscore_overall_*.npy)
#   OVERWRITE RISK: recall_trackC_seeds.py np.save()s
#   finalscore_overall_<scene>__<name>.npy for EVERY arm it scores, and 'canny'
