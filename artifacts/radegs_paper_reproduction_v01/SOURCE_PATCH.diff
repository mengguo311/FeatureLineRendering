diff --git a/submodules/diff-gaussian-rasterization/cuda_rasterizer/paper_distortion.cuh b/submodules/diff-gaussian-rasterization/cuda_rasterizer/paper_distortion.cuh
new file mode 100644
index 0000000..82d31d5
--- /dev/null
+++ b/submodules/diff-gaussian-rasterization/cuda_rasterizer/paper_distortion.cuh
@@ -0,0 +1,17 @@
+// RaDe-GS v2 Eq.23 text variant. Same recurrence tested on CPU and used on CUDA.
+// Weights are constants for backward; z is affine camera-z, never NDC depth.
+#pragma once
+#ifdef __CUDACC__
+#define PAPER_HD __host__ __device__
+#else
+#define PAPER_HD
+#endif
+template<typename T> PAPER_HD inline T paper_distortion_increment(
+    T z, T weight, T prior_mass, T prior_first, T prior_second) {
+    return T(2) * weight * (z*z*prior_mass + prior_second - T(2)*z*prior_first);
+}
+template<typename T> PAPER_HD inline T paper_distortion_gradient(
+    T z, T weight, T total_mass, T total_first) {
+    return T(4) * weight * (total_mass*z - total_first);
+}
+#undef PAPER_HD
